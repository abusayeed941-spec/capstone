[Unit]
Description=E-Commerce Flask Application
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=apprunner
Group=appuser
WorkingDirectory=/opt/ecommerce
EnvironmentFile=/opt/ecommerce/.env
ExecStart=/usr/bin/docker run --rm --name ecommerce-app \
  -p ${PORT}:5000 \
  -e DB_HOST=${DB_HOST} \
  -e DB_PORT=${DB_PORT} \
  -e DB_USER=${DB_USER} \
  -e DB_PASSWORD=${DB_PASSWORD} \
  -e DB_NAME=${DB_NAME} \
  ecommerce-backend:latest
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
