# .gitignore for E-Commerce Capstone Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Terraform
terraform.tfstate
terraform.tfstate.*
*.tfvars
!terraform.tfvars.example
.terraform/
.terraform.lock.hcl

# Ansible Vault
vault.yml
*.vault
.ansible/

# Kubernetes
*.kubeconfig
*.kubeconfig.json
secrets/*.secret
!secrets/*.yml

# Docker
.docker/

# Logs
*.log
logs/
*.log.*

# Temporary
tmp/
temp/
*.tmp
*.bak

# Credentials
.env
.env.*
*.pem
*.key
id_rsa
id_rsa.pub
!id_rsa.pub.example

# Jenkins
.jenkins/
jenkins_home/

# Terraform state (remote option)
*.tfstate
*.tfstate.backup

# Certificates
*.crt
*.csr
*.p12
*.pfx

# Local overrides
docker-compose.override.yml

# Keep these example files
*.example
